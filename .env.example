# Koneksi database Postgres
# Contoh lokal: postgresql://postgres:password@localhost:5432/sistem_rt
# Contoh Supabase/Neon/Railway: pakai connection string yang mereka berikan
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_rumah_tangga

# VAPID keys untuk Web Push Notification
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh-rt.local

# Dipakai sekali saja oleh `npm run db:seed-admin` untuk buat akun admin pertama
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ganti-password-ini
