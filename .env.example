# =========================================================
# KONFIGURASI DOCKER & DATABASE (PRODUKSI / VPS)
# =========================================================
# Untuk Docker Compose di VPS:
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db_vps_yang_aman
DB_NAME=sistem_rt
DB_PORT=5432
APP_PORT=3000
APP_ORIGIN=https://rt.domainanda.com

# Connection String PostgreSQL (Di Docker compose akan otomatis merujuk ke service postgres)
DATABASE_URL=postgresql://postgres:ganti_dengan_password_db_vps_yang_aman@localhost:5432/sistem_rt

# =========================================================
# VAPID KEYS (Web Push Notification)
# =========================================================
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@domainanda.com

# =========================================================
# SEED ADMIN PERTAMA
# =========================================================
# Dipakai sekali saat menjalankan `npm run db:seed-admin`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
